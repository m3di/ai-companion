# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram chat IDs allowed to use the bot.
# Leave empty on first run, message the bot, and read the logged chat ID.
ALLOWED_CHAT_IDS=

# Directory Claude Code operates in (its cwd / file access root).
CLAUDE_WORKING_DIR=

# Claude Code permission mode for the SDK session.
#   default          - prompts for risky actions (no good UX over Telegram)
#   acceptEdits      - auto-accepts file edits, still gates other tools
#   bypassPermissions- runs everything without asking (the "full Claude Code" feel)
# Start with acceptEdits; switch to bypassPermissions once you trust it.
PERMISSION_MODE=acceptEdits

# Optional model override (e.g. claude-opus-4-8). Empty = SDK/CLI default.
CLAUDE_MODEL=

# Path to the dynamic system prompt file (appended to Claude Code's own prompt).
SYSTEM_PROMPT_PATH=prompts/system.md

# SQLite database path.
DB_PATH=data/companion.db
