# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram chat IDs allowed to use the bot.
# Leave empty on first run, message the bot, and read the logged chat ID.
ALLOWED_CHAT_IDS=

# Directory Claude Code operates in (its cwd / file access root).
CLAUDE_WORKING_DIR=

# Root folder holding the repos workers may touch.
# Default: the parent directory of CLAUDE_WORKING_DIR.
WORKSPACE_DIR=

# Claude Code permission mode for the SDK session.
#   default          - prompts for risky actions (no good UX over Telegram)
#   acceptEdits      - auto-accepts file edits, still gates other tools
#   bypassPermissions- runs everything without asking (the "full Claude Code" feel)
# Start with acceptEdits; switch to bypassPermissions once you trust it.
PERMISSION_MODE=acceptEdits

# Optional model override (e.g. claude-opus-4-8). Empty = SDK/CLI default.
# This is the CONCIERGE's (and the night's) model.
CLAUDE_MODEL=

# Thinking effort for the concierge's own turns (low | medium | high). Most of
# them are routing and relay; medium is the default and the ledger judges.
CONCIERGE_EFFORT=medium

# Built-in tools the concierge may have (SDK `tools`; MCP tools are unaffected).
# Default "Bash,WebFetch" — what the ledger shows it uses (gh/fibery grounding,
# links); Read/Grep/Glob/Edit/Write are off (Read was the raw-file bypass path
# and went unused). Every unneeded schema sits in the cache prefix.
# CONCIERGE_BUILTIN_TOOLS=Bash,WebFetch

# Default model + effort for WORKERS the concierge dispatches without sizing
# them (it can pick haiku/sonnet/opus and low/medium/high per dispatch).
WORKER_MODEL=sonnet
WORKER_EFFORT=medium

# Path to the dynamic system prompt file (appended to Claude Code's own prompt).
SYSTEM_PROMPT_PATH=prompts/system.md

# SQLite database path (the "firehose": sessions, messages, dreams).
DB_PATH=data/companion.db

# Git-tracked knowledge base directory (the curated long-term brain).
KNOWLEDGE_DIR=data/knowledge

# VOICE IN — voice notes are transcribed LOCALLY with whisper.cpp before they
# reach the concierge (brew install whisper-cpp ffmpeg; download a ggml model
# from https://huggingface.co/ggerganov/whisper.cpp). Nothing here uses
# Telegram's own (Premium) transcription, so it survives a change of transport.
# WHISPER_BIN=whisper-cli
# WHISPER_MODEL=~/whisper-models/ggml-large-v3-turbo.bin
# WHISPER_LANGUAGE=auto
# VOICE_DIR=data/voice
# VOICE OUT — the bot speaks with Piper (rhasspy) in its own venv:
#   python3 -m venv ~/piper/venv && ~/piper/venv/bin/pip install piper-tts
# and voices (.onnx + .onnx.json pairs) under ~/piper/voices from
# https://huggingface.co/rhasspy/piper-voices. Calibrate with /voice samples.
# PIPER_BIN=~/piper/venv/bin/piper
# PIPER_VOICES_DIR=~/piper/voices

# Hour of day (0-23, local time) to run the nightly pipeline (dream → grow).
NIGHTLY_HOUR=4

# Hour of day (0-23, local time) for the default morning-brief wakeup (seeded
# once per chat; the bot can reschedule or disable it from then on).
MORNING_HOUR=8

# THE ATLAS — the live graph dashboard (docs/plans/atlas-visualization.md).
# Unset or 0 = not started at all. Binds to 127.0.0.1 only; read-only, no auth.
# Build the client once with `npm run atlas:build`.
ATLAS_PORT=7391

# Transcripts a PROGRAM drove (Agent SDK runs: the bot's fleet, storysim's simulator)
# are never harvested. Comma list, trailing * = prefix. Default: sdk-*
# NO_HARVEST_ENTRYPOINTS=sdk-*
